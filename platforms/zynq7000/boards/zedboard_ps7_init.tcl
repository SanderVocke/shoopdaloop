proc ps7_run {name} {
    global ps7_sequences
    foreach op $ps7_sequences($name) {
        set address [lindex $op 1]
        switch -- [lindex $op 0] {
            write {
                mwr -force $address [lindex $op 2]
            }
            mask_write {
                lassign [lrange $op 2 3] mask value
                set current [mrd -force -value $address]
                mwr -force $address [expr {($value & $mask) | ($current & ~$mask)}]
            }
            mask_poll {
                set mask [lindex $op 2]
                set deadline [expr {[clock milliseconds] + 1000}]
                while {([mrd -force -value $address] & $mask) == 0} {
                    if {[clock milliseconds] > $deadline} {
                        error [format "ps7 %s: timeout polling 0x%08X for mask 0x%08X" $name $address $mask]
                    }
                }
            }
        }
    }
}

proc ps7_version {} {
    # PS_VERSION in MCTRL[31:28]: 0 is silicon 1.0, 1 is 2.0, later ones use 3.0.
    switch -- [expr {([mrd -force -value 0xF8007080] >> 28) & 0xF}] {
        0 { return 1_0 }
        1 { return 2_0 }
        default { return 3_0 }
    }
}

proc ps7_init {} {
    set version [ps7_version]
    foreach name {mio pll clock ddr peripherals} {
        ps7_run ${name}_$version
    }
}

proc ps7_post_config {} {
    ps7_run post_config_[ps7_version]
}
