diff --git a/src/controller.cc b/src/controller.cc
index a582dcc..198227c 100644
--- a/src/controller.cc
+++ b/src/controller.cc
@@ -144,0 +145,5 @@ void Controller::ClockTick() {
+    while (!bus_events_.empty() && bus_events_.begin()->first <= clk_) {
+        if (bus_events_.begin()->second) ++bus_counters_.write_cycles;
+        else ++bus_counters_.read_cycles;
+        bus_events_.erase(bus_events_.begin());
+    }
@@ -236,0 +242,8 @@ void Controller::IssueCommand(const Command &cmd) {
+    ++bus_counters_.command_cycles;
+    if (cmd.IsReadWrite()) {
+        if (cmd.IsWrite()) ++bus_counters_.write_commands;
+        else ++bus_counters_.read_commands;
+        auto delay = cmd.IsWrite() ? config_.write_delay : config_.read_delay;
+        for (int cycle = 0; cycle < config_.burst_cycle; ++cycle)
+            bus_events_.emplace(clk_ + delay - config_.burst_cycle + cycle, cmd.IsWrite());
+    }
@@ -258,0 +272 @@ void Controller::IssueCommand(const Command &cmd) {
+        write_done_ = std::max(write_done_, clk_ + config_.write_delay);
