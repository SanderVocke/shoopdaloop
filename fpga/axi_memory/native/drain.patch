diff --git a/src/dram_system.h b/src/dram_system.h
index 7864b2c..226bb0f 100644
--- a/src/dram_system.h
+++ b/src/dram_system.h
@@ -29,0 +30,16 @@ class BaseDRAMSystem {
+    BusCounters GetBusCounters() const {
+        BusCounters result;
+        for (const auto* controller : ctrls_) {
+            auto counters = controller->GetBusCounters();
+            result.read_cycles += counters.read_cycles;
+            result.write_cycles += counters.write_cycles;
+            result.read_commands += counters.read_commands;
+            result.write_commands += counters.write_commands;
+            result.command_cycles += counters.command_cycles;
+        }
+        return result;
+    }
+    bool IsIdle() const {
+        for (const auto* controller : ctrls_) if (!controller->IsIdle()) return false;
+        return true;
+    }
