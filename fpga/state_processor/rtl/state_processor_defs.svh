`ifndef SHOOP_STATE_PROCESSOR_DEFS_SVH
`define SHOOP_STATE_PROCESSOR_DEFS_SVH

`define SHOOP_SP_INSTRUCTION_BITS 96
`define SHOOP_SP_STATE_BITS 129
`define SHOOP_SP_JOB_BITS 256

`define SHOOP_SP_PROCESS_INPUT    8'h00
`define SHOOP_SP_PROCESS_PLAYBACK 8'h01
`define SHOOP_SP_PROCESS_GAIN     8'h02
`define SHOOP_SP_PROCESS_MIX      8'h03
`define SHOOP_SP_PROCESS_CAPTURE  8'h04
`define SHOOP_SP_PROCESS_OUTPUT   8'h05
`define SHOOP_SP_LOGICAL_PLAYBACK 8'h06
`define SHOOP_SP_LOGICAL_CAPTURE  8'h07

`define SHOOP_SP_JOB_INPUT    8'h00
`define SHOOP_SP_JOB_SILENCE  8'h01
`define SHOOP_SP_JOB_READ     8'h02
`define SHOOP_SP_JOB_GAIN     8'h03
`define SHOOP_SP_JOB_MIX      8'h04
`define SHOOP_SP_JOB_CAPTURE  8'h05
`define SHOOP_SP_JOB_OUTPUT   8'h06

`define SHOOP_SP_OK              8'h00
`define SHOOP_SP_QUEUE_FULL      8'h01
`define SHOOP_SP_INVALID_STATE   8'h02
`define SHOOP_SP_INVALID_PROGRAM 8'h03

`endif
