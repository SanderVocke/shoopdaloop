+
+
+def case_name(case):
+    suite, (p, k, n), variant, mode, repeat, _ = case
+    return f"{suite}-p{p}-k{k}-n{n}-{variant}-{mode}-r{repeat}"
+
+
+def run_case(args, output, machine, case):
+    ident = case_name(case)
+    path = output / f"{ident}.json"
