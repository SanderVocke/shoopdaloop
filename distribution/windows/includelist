# Libraries that get bundled into the package when a dependency scan reaches
# them. Anything reached that matches neither this file nor the excludelist is a
# build error, so that a new third-party dependency has to be looked at rather
# than silently shipped or silently dropped.
#
# This file takes precedence over the excludelist, which is how the few
# redistributables that live in System32 (the MSVC runtime, dbghelp) get bundled.
# Do not add a genuine Windows system DLL here -- put it in the excludelist.
*/brotlicommon.dll
*/brotlidec.dll
*/bz2*.dll
*/dbghelp.dll
*/double-conversion.dll
*/FLAC.dll
*/freetype*.dll
*/harfbuzz.dll
*/icu*.dll
# JPEG decoding, needed by Qt6/plugins/imageformats/qjpeg.dll.
*/jpeg62.dll
*/libcrypto-*.dll
*/lilv-*.dll
*/libmp3lame.DLL
*/libpng*.dll
# The other half of OpenSSL, needed by Qt6/plugins/tls/qopensslbackend.dll.
# libcrypto without libssl is not a working TLS backend.
*/libssl-*.dll
*/lua.dll
# Mesh optimisation, needed by Qt6Quick3DUtils. Was bundled unconditionally
# before the dependency scan could reach the QML plugins that need it.
*/meshoptimizer.dll
*/mpg123.dll
*/MSVCP*.dll
*/ogg.dll
*/opus.dll
*/pcre2-*.dll
*/pthreadVC3*.dll
*/Qt6*.dll
*/serd-*.dll
*/shoopdaloop_backend.dll
*/sndfile*.dll
*/sord-*.dll
*/sratom-*.dll
# Needed by Qt6/plugins/sqldrivers/qsqlite.dll, which QtQuick.LocalStorage uses.
*/sqlite3.dll
*/VCRUNTIME*.dll
*/vorbis.dll
*/vorbisenc.dll
*/zlib*.dll
*/zlibd1.dll
*/zix-*.dll
*/zstd.dll
