#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# AppImage runtimes can replace lilv's compiled-in search prefix. Keep an
# explicitly supplied LV2_PATH and add the standard user/system locations so
# externally installed Carla bundles remain discoverable.
export LV2_PATH="${LV2_PATH:+${LV2_PATH}:}${HOME}/.lv2:/usr/local/lib/lv2:/usr/local/lib64/lv2:/usr/local/lib/x86_64-linux-gnu/lv2:/usr/lib/lv2:/usr/lib64/lv2:/usr/lib/x86_64-linux-gnu/lv2"

if [ -n "$SHOOPDALOOP_APPIMAGE_EXECUTE" ]; then
    "${SCRIPT_DIR}/${SHOOPDALOOP_APPIMAGE_EXECUTE}" "$@"
else
    "${SCRIPT_DIR}/shoopdaloop" "$@"
fi