{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document",
  "type": "object",
  "properties": {
    "format_version": {
      "$ref": "#/$defs/FormatVersion"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version",
    "payload"
  ],
  "$defs": {
    "Address": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "AudioCase": {
      "type": "object",
      "properties": {
        "buffers": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "initial_state": {
          "$ref": "#/$defs/StateSnapshot"
        },
        "media": {
          "$ref": "#/$defs/MediaSnapshot"
        },
        "name": {
          "type": "string"
        },
        "output_ports": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "program": {
          "$ref": "#/$defs/Program"
        },
        "queue_capacity": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioStep"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "program",
        "initial_state",
        "queue_capacity",
        "buffers",
        "output_ports",
        "steps"
      ]
    },
    "AudioResult": {
      "type": "object",
      "properties": {
        "buffers": {
          "type": "array",
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648
            }
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Job"
          }
        },
        "media": {
          "$ref": "#/$defs/MediaSnapshot"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648
            }
          }
        },
        "remaining_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Job"
          }
        },
        "stage": {
          "$ref": "#/$defs/ExecutionStage"
        },
        "state": {
          "$ref": "#/$defs/StateSnapshot"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "jobs",
        "remaining_jobs",
        "state",
        "buffers",
        "outputs",
        "stage",
        "status"
      ]
    },
    "AudioStep": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648
            }
          }
        },
        "media_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaAction"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateWrite"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "writes",
        "inputs"
      ]
    },
    "AudioTrace": {
      "type": "object",
      "properties": {
        "case": {
          "$ref": "#/$defs/AudioCase"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioResult"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "case",
        "results"
      ]
    },
    "Binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "playback"
            },
            "value": {
              "type": "object",
              "properties": {
                "enabled": {
                  "$ref": "#/$defs/Address"
                },
                "length": {
                  "$ref": "#/$defs/Address"
                },
                "position": {
                  "$ref": "#/$defs/Address"
                }
              },
              "additionalProperties": false,
              "required": [
                "position",
                "length",
                "enabled"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gain"
            },
            "value": {
              "type": "object",
              "properties": {
                "ramp": {
                  "$ref": "#/$defs/Address"
                }
              },
              "additionalProperties": false,
              "required": [
                "ramp"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capture"
            },
            "value": {
              "type": "object",
              "properties": {
                "enabled": {
                  "$ref": "#/$defs/Address"
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "BufferId": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "ChunkId": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "Compiled": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "initial_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          }
        },
        "program": {
          "$ref": "#/$defs/Program"
        }
      },
      "additionalProperties": false,
      "required": [
        "program",
        "initial_state",
        "bindings"
      ]
    },
    "Error": {
      "type": "string",
      "enum": [
        "invalid_graph",
        "invalid_state",
        "invalid_buffer",
        "invalid_view",
        "invalid_shape",
        "queue_full",
        "memory_full"
      ]
    },
    "ExecutionStage": {
      "type": "string",
      "enum": [
        "media",
        "state",
        "jobs"
      ]
    },
    "ExecutionStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "value": {
              "type": "object",
              "properties": {
                "error": {
                  "$ref": "#/$defs/Error"
                }
              },
              "additionalProperties": false,
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "FormatVersion": {
      "type": "integer",
      "const": 1
    },
    "Graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "quantum": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "quantum",
        "nodes"
      ]
    },
    "Instruction": {
      "description": "Operands reference live state, never values specialized to the current mode.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "process_input"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "port",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "enabled": {
              "$ref": "#/$defs/Address"
            },
            "kind": {
              "type": "string",
              "const": "process_loop_playback"
            },
            "length": {
              "$ref": "#/$defs/Address"
            },
            "position": {
              "$ref": "#/$defs/Address"
            },
            "view": {
              "$ref": "#/$defs/Address"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view",
            "position",
            "length",
            "enabled",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "process_gain"
            },
            "ramp": {
              "$ref": "#/$defs/Address"
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "ramp",
            "source",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "process_mix"
            },
            "left": {
              "$ref": "#/$defs/BufferId"
            },
            "right": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "$ref": "#/$defs/Address"
            },
            "kind": {
              "type": "string",
              "const": "process_loop_capture"
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            },
            "view": {
              "$ref": "#/$defs/Address"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view",
            "enabled",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "process_output"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "port"
          ]
        }
      ]
    },
    "Job": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "input"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "port",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "silence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "read_view"
            },
            "length": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            },
            "position": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view",
            "position",
            "length",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "gain"
            },
            "ramp": {
              "$ref": "#/$defs/Ramp"
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "destination",
            "ramp"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/BufferId"
            },
            "kind": {
              "type": "string",
              "const": "mix"
            },
            "left": {
              "$ref": "#/$defs/BufferId"
            },
            "right": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capture"
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "view"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "output"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "source": {
              "$ref": "#/$defs/BufferId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "port"
          ]
        }
      ]
    },
    "MediaAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clear"
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remove"
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view"
          ]
        }
      ]
    },
    "MediaSnapshot": {
      "type": "object",
      "properties": {
        "chunk_frames": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "chunk_limit": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "free_chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChunkId"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648
          }
        },
        "views": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ViewSnapshot"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "chunk_frames",
        "samples",
        "free_chunks",
        "views"
      ]
    },
    "Node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "input"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "playback"
            },
            "length": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            },
            "playing": {
              "type": "boolean"
            },
            "position": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "view",
            "length",
            "position",
            "playing"
          ]
        },
        {
          "type": "object",
          "properties": {
            "gain": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648
            },
            "input": {
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "type": "string",
              "const": "gain"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "gain"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mix"
            },
            "left": {
              "$ref": "#/$defs/NodeId"
            },
            "right": {
              "$ref": "#/$defs/NodeId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "type": "string",
              "const": "capture"
            },
            "recording": {
              "type": "boolean"
            },
            "view": {
              "$ref": "#/$defs/ViewId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "view",
            "recording"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "type": "string",
              "const": "output"
            },
            "port": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "port"
          ]
        }
      ]
    },
    "NodeId": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "OnWrap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/NodeId"
        },
        "target": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "enabled"
      ]
    },
    "Payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "graph"
            },
            "value": {
              "$ref": "#/$defs/Graph"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "compiled"
            },
            "value": {
              "$ref": "#/$defs/Compiled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "program"
            },
            "value": {
              "$ref": "#/$defs/Program"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instructions"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Instruction"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "state"
            },
            "value": {
              "$ref": "#/$defs/StateSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jobs"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Job"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
