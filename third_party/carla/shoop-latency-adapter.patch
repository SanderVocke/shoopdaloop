+bool PatchbayGraph::getLatencyRange(uint32_t& minimumFrames,
+                                       uint32_t& maximumFrames,
+                                       uint32_t& pathCount,
+                                       bool& overflow) const noexcept
+{
+    minimumFrames = maximumFrames = pathCount = 0;
+    overflow = false;
+    const int nodeCount = graph.getNumNodes();
+    if (nodeCount <= 0)
+        return false;
+
+    struct State {
+        uint32_t id, latency, indegree, outdegree;
+        uint64_t minimum, maximum, paths;
+        bool reachable, audioIo;
+    };
+    std::vector<State> states(static_cast<size_t>(nodeCount));
+    std::vector<std::vector<uint32_t> > edges(static_cast<size_t>(nodeCount));
+    for (int i = 0; i < nodeCount; ++i) {
+        AudioProcessorGraph::Node* const node = graph.getNode(i);
+        CARLA_SAFE_ASSERT_RETURN(node != nullptr, false);
+        uint32_t latency = 0;
+        if (node->properties.isPlugin) {
+            const CarlaPluginPtr plugin = kEngine->getPlugin(node->properties.pluginId);
+            if (plugin && plugin->isEnabled())
+                latency = plugin->getLatencyInFrames();
+        }
+        states[static_cast<size_t>(i)] = {
+            node->nodeId, latency, 0, 0, 0, 0, 0, false,
+            node->properties.isAudio && ! node->properties.isPlugin
+        };
+    }
+    const auto indexForId = [&states](const uint32_t id) noexcept -> int {
+        for (size_t i = 0; i < states.size(); ++i)
+            if (states[i].id == id)
+                return static_cast<int>(i);
+        return -1;
+    };
+    for (size_t i = 0; i < graph.getNumConnections(); ++i) {
+        const AudioProcessorGraph::Connection* const connection = graph.getConnection(i);
+        if (connection == nullptr || connection->channelType != AudioProcessor::ChannelTypeAudio)
+            continue;
+        const int source = indexForId(connection->sourceNodeId);
+        const int destination = indexForId(connection->destNodeId);
+        if (source < 0 || destination < 0 || source == destination)
+            return false;
+        edges[static_cast<size_t>(source)].push_back(static_cast<uint32_t>(destination));
+        ++states[static_cast<size_t>(source)].outdegree;
+        ++states[static_cast<size_t>(destination)].indegree;
+    }
+
+    std::vector<uint32_t> indegrees, queue;
+    indegrees.reserve(states.size());
+    queue.reserve(states.size());
+    for (size_t i = 0; i < states.size(); ++i) {
+        indegrees.push_back(states[i].indegree);
+        if (states[i].indegree == 0) {
+            queue.push_back(static_cast<uint32_t>(i));
+            if (states[i].audioIo) {
+                states[i].reachable = true;
+                states[i].paths = 1;
+            }
+        }
+    }
+    size_t processed = 0;
+    for (size_t cursor = 0; cursor < queue.size(); ++cursor) {
+        const uint32_t sourceIndex = queue[cursor];
+        State& source = states[sourceIndex];
+        ++processed;
+        for (const uint32_t destinationIndex : edges[sourceIndex]) {
+            State& destination = states[destinationIndex];
+            if (source.reachable) {
+                const uint64_t candidateMinimum = source.minimum + destination.latency;
+                const uint64_t candidateMaximum = source.maximum + destination.latency;
+                if (! destination.reachable || candidateMinimum < destination.minimum)
+                    destination.minimum = candidateMinimum;
+                if (! destination.reachable || candidateMaximum > destination.maximum)
+                    destination.maximum = candidateMaximum;
+                destination.reachable = true;
+                destination.paths += source.paths;
+                if (destination.paths > UINT32_MAX || destination.maximum > UINT32_MAX) {
+                    overflow = true;
+                    return true;
+                }
+            }
+            if (--indegrees[destinationIndex] == 0)
+                queue.push_back(destinationIndex);
+        }
+    }
+    if (processed != states.size())
+        return false;
+
+    bool found = false;
+    uint64_t minimum = std::numeric_limits<uint64_t>::max(), maximum = 0, paths = 0;
+    for (const State& state : states) {
+        if (! state.audioIo || state.outdegree != 0 || ! state.reachable)
+            continue;
+        found = true;
+        if (state.minimum < minimum)
+            minimum = state.minimum;
+        if (state.maximum > maximum)
+            maximum = state.maximum;
+        paths += state.paths;
+        if (paths > UINT32_MAX) {
+            overflow = true;
+            return true;
+        }
+    }
+    if (! found)
+        return false;
+    minimumFrames = static_cast<uint32_t>(minimum);
+    maximumFrames = static_cast<uint32_t>(maximum);
+    pathCount = static_cast<uint32_t>(paths);
+    return true;
+}
